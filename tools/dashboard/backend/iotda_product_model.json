    },
    {
     "property_id": "commStatus",
     "property_name": "通信健康状态位域",
     "data_type": "int",
     "required": false,
     "method": "R",
     "min": 0,
     "max": 4294967295,
     "step": 1,
     "description": "设备自报通信状态位域(取代前端推断, 监控真·同步): bit0=WiFi已连 bit1=MQTT已连 bit2=TLS握手成功 bit3=云端可达(最近publish成功) bit4=CAN正常 bit5=CAN未启用(硬件屏蔽). 固件由WiFi/MQTT/CAN真实连接态置位, 随属性上报"
    }
